{
  "name": "@workspace/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mealplan": {
      "types": "./dist/types/src/mealplan/index.d.ts",
      "default": "./src/mealplan/index.ts"
    },
    "./data/*": "./data/*",
    "./constants/*": {
      "types": "./dist/types/constants/*.d.ts",
      "default": "./constants/*.ts"
    },
    "./*": {
      "types": "./dist/types/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "postinstall": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/__tests__/*.test.ts src/__tests__/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build:recipes": "node scripts/build-recipes.mjs"
  },
  "dependencies": {
    "@workspace/config": "workspace:*",
    "@workspace/life-data": "workspace:*",
    "tiny-inflate": "1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@workspace/tsconfig": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
